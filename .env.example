# Copy to .env.local and fill in. .env.local stays out of git.

# The UwUMail server `pnpm dev` talks to, with protocol and without a path.
# Leave it empty to work on sample data without any server.
UWUMAIL_DEV_SERVER=https://mail.example.test

# Set to 1 when that server carries a self-signed certificate, as test servers do.
UWUMAIL_DEV_SERVER_INSECURE=0
